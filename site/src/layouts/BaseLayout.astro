---
import { withBase } from '../lib/base';
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/fraunces';
// Same files the font CSS points at, so the preloads below fetch them up front
// instead of the page painting in a fallback font and then swapping.
import dmSansUrl from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, ADSENSE_CLIENT } from '../data/site';
import { paintFavicon, timerFavicon } from '../workspace/ticker';
import { STORAGE_KEY } from '../workspace/storage';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  /** Hide header/footer (used by the full-screen workspace). */
  bare?: boolean;
  /** Content pages may show ads; tool pages like the workspace should not. */
  ads?: boolean;
}

const { title, description = SITE.description, image, type = 'website', bare = false, ads = true } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name}: cozy study workspace & pomodoro timer`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : undefined;

// Runs before anything renders: if a session is ticking, show the progress ring
// straight away instead of flashing the plain icon until the page's scripts load.
// The key matches setFaviconProgress so it doesn't redraw the same picture.
const earlyFavicon = `try {
  var ring = (${timerFavicon.toString()})((JSON.parse(localStorage.getItem(${JSON.stringify(STORAGE_KEY)}) || 'null') || {}).state);
  if (ring) {
    var icon = document.querySelector('link[rel="icon"]');
    icon.href = (${paintFavicon.toString()})(ring.progress, ring.color);
    icon.dataset.key = Math.round(ring.progress * 60) + '-' + ring.color;
  }
} catch (e) {}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={dmSansUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('/favicon.svg')} data-key="default" />
    <script is:inline set:html={earlyFavicon} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#2a1b3d" />
    {
      ads && ADSENSE_CLIENT && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
          crossorigin="anonymous"
        />
      )
    }
    <slot name="head" />
  </head>
  <body class={bare ? 'overflow-hidden !bg-[#2a1b3d]' : 'min-h-screen flex flex-col'}>
    {bare ? <slot /> : (
      <>
        <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 bg-paper px-3 py-2 rounded">Skip to content</a>
        <Header />
        <main id="main" class="flex-1">
          <slot />
        </main>
        <Footer />
      </>
    )}
  </body>
</html>

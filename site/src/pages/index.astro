---
import { withBase } from '../lib/base';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoCard from '../components/VideoCard.astro';
import HeroIntro from '../components/HeroIntro.astro';
import HomeHero from '../workspace/HomeHero';
import { VIDEOS } from '../data/videos';
import { DECOR, RESIDENTS } from '../workspace/rewards';
import { SITE } from '../data/site';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const featured = VIDEOS.filter((v) => ['library-fireplace-thunderstorm', 'yokohama-harbour-25-5', 'animal-crossing-ambience'].includes(v.slug));

const hours = (m: number) => (m < 60 ? `${m} min` : `${Math.round((m / 60) * 10) / 10} h`);
// First frame of each resident's idle animation, drawn at 2x.
const residentCards = RESIDENTS.map((r) => {
  const a = r.sprite.idle;
  return { ...r, a, k: 2 * (r.sprite.scale ?? 1) * (a.w <= 16 ? 2 : 1) };
});

const features = [
  { icon: '⏱️', t: 'A timer that keeps going', d: 'Focus, short and long breaks with your own lengths. It keeps counting in a background tab and while you read the guides here, and the tab icon fills up as you go.' },
  { icon: '✅', t: 'Tasks you can shape', d: 'Prioritise, drag to reorder, break work into small steps and track how many focus minutes went into each one.' },
  { icon: '📝', t: 'Distraction notepad', d: 'Park stray thoughts so they stop nagging you mid-session. Deal with them on your break.' },
  { icon: '🎧', t: 'Music & rain', d: 'A built-in player with our favourite lofi, ambience and pomodoro videos, plus a gentle rain generator that needs no download.' },
  { icon: '🌗', t: 'A village on your clock', d: 'Sunrise, golden hour and starry nights follow your local time. Lamps and campfires glow after dark.' },
  { icon: '🔒', t: 'Private by default', d: 'No account. Progress is saved in your own browser, with a backup file you can download any time.' },
];
---

<BaseLayout>
  <HomeHero client:only="react">
    <HeroIntro />
    <section slot="fallback" class="relative h-[calc(100svh-3.75rem)] min-h-[34rem] bg-gradient-to-b from-[#1d1430] via-[#3b2a5c] to-[#2f4a3a] text-white">
      <div class="flex justify-center px-4 pt-[6vh] sm:pt-[9vh]">
        <div class="w-full max-w-xl rounded-[2rem] border border-white/15 bg-black/35 p-6 text-center sm:p-8">
          <HeroIntro />
        </div>
      </div>
    </section>
  </HomeHero>

  <!-- How it works -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h2 class="text-center font-display text-3xl font-semibold">How it works</h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-3">
      {
        [
          { n: '1', t: 'Pick a task', d: 'Write down what you want to get done and break it into small, concrete steps. Starting is the hardest part, so make the first step tiny.' },
          { n: '2', t: 'Focus for one session', d: 'Start a 25-minute pomodoro (or set your own length). Put your phone away, turn on rain or a study playlist, and work on just that one thing.' },
          { n: '3', t: 'Watch your village grow', d: 'Finished sessions and tasks earn coins. Spend them on trees, lamps, cottages and more, and new residents move in as your focus time adds up.' },
        ].map((s) => (
          <div class="rounded-2xl border border-line bg-paper p-6 shadow-sm">
            <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-plum text-lg font-semibold text-white">{s.n}</span>
            <h3 class="mt-4 text-lg font-semibold">{s.t}</h3>
            <p class="mt-2 text-ink/75">{s.d}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Residents -->
  <section class="bg-[#2a1b3d] py-16 text-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl font-semibold">Meet the neighbours</h2>
        <p class="mt-3 text-white/75">
          {RESIDENTS.length} residents move in as your total focus time grows. They wander the village, play tag, chat with each other and react when you click them. Pick from {DECOR.length} decorations to build them a home.
        </p>
      </div>
      <ul class="mt-8 grid grid-cols-3 gap-3 sm:grid-cols-5 lg:grid-cols-7">
        {
          residentCards.map((r) => (
            <li class="flex flex-col items-center rounded-xl border border-white/10 bg-white/5 px-2 pb-3 pt-4 text-center">
              <span
                class="pixelated block"
                style={`width:${r.a.w * r.k}px;height:${r.a.h * r.k}px;background-image:url(${r.a.src});background-size:${r.a.frames * r.a.w * r.k}px auto;background-position:0 -${(r.a.y ?? 0) * r.k}px;image-rendering:pixelated;`}
                aria-hidden="true"
              />
              <span class="mt-2 text-sm font-semibold">{r.name}</span>
              <span class="text-[11px] text-white/50">{r.species} · {hours(r.unlockAt)}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Features -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="max-w-xl font-display text-3xl font-semibold">Everything for a study session, in one tab</h2>
      <a href={withBase('/workspace')} class="btn-pixel bg-plum text-white">Open the workspace</a>
    </div>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f) => (
          <div class="rounded-2xl border border-line bg-paper p-5 shadow-sm">
            <span class="text-2xl" aria-hidden="true">{f.icon}</span>
            <h3 class="mt-3 font-semibold">{f.t}</h3>
            <p class="mt-1.5 text-sm text-ink/75">{f.d}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Guides -->
  {
    articles.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
        <div class="flex items-end justify-between gap-4">
          <h2 class="font-display text-3xl font-semibold">Latest study guides</h2>
          <a href={withBase('/articles')} class="font-semibold text-plum hover:underline">All guides →</a>
        </div>
        <div class="mt-8 grid gap-6 md:grid-cols-3">
          {articles.map((a) => (
            <a href={withBase(`/articles/${a.id}`)} class="group rounded-2xl border border-line bg-paper p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg">
              <span class="text-3xl">{a.data.emoji}</span>
              <p class="mt-3 text-xs font-bold uppercase tracking-wider text-plum">{a.data.category}</p>
              <h3 class="mt-1 text-lg font-semibold leading-snug group-hover:text-plum">{a.data.title}</h3>
              <p class="mt-2 text-sm text-ink/70">{a.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <!-- Videos -->
  <section class="bg-paper py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="flex items-end justify-between gap-4">
        <h2 class="font-display text-3xl font-semibold">Study videos we love</h2>
        <a href={withBase('/videos')} class="font-semibold text-plum hover:underline">Browse the library →</a>
      </div>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((v) => <VideoCard video={v} />)}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h2 class="text-center font-display text-3xl font-semibold">Questions</h2>
    <div class="mt-8 space-y-3">
      {
        [
          { q: 'Is it really free?', a: `Yes. ${SITE.name} is free to use, with no account and no download. The site may show a small number of ads on article pages to cover hosting, but never inside the workspace while you study.` },
          { q: 'Where is my progress saved?', a: 'In your browser, on your device. Nothing is uploaded. Clearing your browser data will erase it, so use "Download backup" in the workspace settings if you want to keep a copy or move to another device.' },
          { q: 'What is the pomodoro technique?', a: 'A simple method where you work in short, timed bursts (traditionally 25 minutes) followed by short breaks, with a longer break every four rounds. Our guide explains how to get the most out of it.' },
          { q: 'Does my timer keep going if I leave the workspace?', a: `Yes. The timer is based on the clock, not on the page staying open. While you browse ${SITE.name} a small timer shows in the header and you still get your coins and chime when the session ends. If you close the site completely, the session is counted the next time you open it. Music and rain stop when you leave the workspace page, though.` },
          { q: 'Does it work on my phone?', a: 'Yes. The workspace works on phones and tablets too, though it is cosiest on a laptop or desktop where the village has room to spread out.' },
        ].map((f) => (
          <details class="group rounded-xl border border-line bg-paper p-5">
            <summary class="cursor-pointer list-none font-semibold">
              <span class="mr-2 inline-block transition group-open:rotate-90">›</span>
              {f.q}
            </summary>
            <p class="mt-3 text-ink/75">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
---

<BaseLayout title="Contact" description={`How to get in touch with ${SITE.name}.`}>
  <article class="prose prose-lg mx-auto max-w-3xl px-4 pt-12 prose-headings:font-pixel prose-a:text-plum sm:px-6">
    <h1>Contact</h1>
    <p>Questions, bug reports, feature ideas, or a study video you think belongs in the library? I'd love to hear from you.</p>
    {
      SITE.contactEmail ? (
        <p>
          Email: <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
        </p>
      ) : (
        <p><em>Contact details coming soon.</em></p>
      )
    }
    <p>I read everything, though it may take a few days to reply during exam season.</p>
  </article>
</BaseLayout>
